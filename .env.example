# Hosting settings only. The Java app reads environment variables, not this file.
QUIZ_PRODUCTION=true
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Set this to the exact HTTPS origin. Render supplies RENDER_EXTERNAL_URL automatically.
PUBLIC_URL=https://YOUR-APP-HOSTNAME
# Random secret, at least 24 characters. Used once to create the first admin.
QUIZ_SETUP_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_VALUE
PORT=8080
